    "gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n",
    "idx_train, idx_test = next(gss.split(df, groups=df[\"country\"]))\n",
    "train, test = df.iloc[idx_train], df.iloc[idx_test]\n",
    "print(f\"Entrenamiento: {train['country'].nunique()} países, {len(train):,} filas\")\n",
    "print(f\"Prueba:        {test['country'].nunique()} países, {len(test):,} filas\")\n",
    "\n",
    "def ajustar(variables, nombre):\n",
    "    modelo = LinearRegression().fit(train[variables], train[\"log_co2_pc\"])\n",
    "    pred = modelo.predict(test[variables])\n",
    "    real = test[\"log_co2_pc\"]\n",
    "    res = {\n",
    "        \"Modelo\": nombre,\n",
    "        \"R² (prueba)\": r2_score(real, pred),\n",
    "        \"RMSE (log)\": np.sqrt(mean_squared_error(real, pred)),\n",
    "        \"Error medio (t CO₂/persona)\": mean_absolute_error(np.exp(real), np.exp(pred)),\n",
    "    }\n",
