    "# 1. Quitar regiones y agregados: los países tienen código ISO de 3 letras, los demás no.\n",
    "df = df[df[\"iso_code\"].notna() & ~df[\"iso_code\"].astype(str).str.startswith(\"OWID\")]\n",
    "registro.append((\"Solo países (sin regiones ni 'World')\", len(df)))\n",
    "\n",
    "# 2. El PIB solo es confiable desde 1990.\n",
    "df = df[df[\"year\"] >= 1990]\n",
    "registro.append((\"Años desde 1990\", len(df)))\n",
    "\n",
    "# 3. Quedarse con filas completas en las variables del análisis.\n",
    "df = df.dropna(subset=[\"population\", \"gdp\", \"co2_per_capita\", \"energy_per_capita\"])\n",
    "registro.append((\"Sin datos faltantes\", len(df)))\n",
    "\n",
    "# 4. Países muy pequeños distorsionan el promedio; se exige al menos 1 millón de habitantes.\n",
    "df = df[df[\"population\"] >= 1_000_000]\n",
    "registro.append((\"Población de 1 millón o más\", len(df)))\n",
    "\n",
    "# 5. Valor atípico con causa conocida: Kuwait en 1991 (ver la revisión de la celda anterior).\n",
    "df = df[~((df[\"country\"] == \"Kuwait\") & (df[\"year\"] == 1991))]\n",
    "registro.append((\"Sin Kuwait 1991 (incendios de pozos petroleros)\", len(df)))\n",
    "\n",
    "# 6. Variables derivadas. El logaritmo hace falta porque ingreso y emisiones\n",
    "#    crecen en proporciones, no en cantidades fijas.\n",
    "df[\"gdp_per_capita\"] = df[\"gdp\"] / df[\"population\"]\n",
    "df = df[(df[\"gdp_per_capita\"] > 0) & (df[\"co2_per_capita\"] > 0) & (df[\"energy_per_capita\"] > 0)]\n",
    "registro.append((\"Valores positivos (para poder usar logaritmos)\", len(df)))\n",
    "\n",
    "df[\"log_gdp_pc\"] = np.log(df[\"gdp_per_capita\"])\n",
    "df[\"log_co2_pc\"] = np.log(df[\"co2_per_capita\"])\n",
    "df[\"log_energy_pc\"] = np.log(df[\"energy_per_capita\"])\n",
    "df = df.reset_index(drop=True)\n",
    "\n",
    "pd.DataFrame(registro, columns=[\"Paso\", \"Filas restantes\"])"
   ]
